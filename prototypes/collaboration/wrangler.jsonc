{
    // Local only: run with `pnpm dev` (wrangler dev). Never deployed.
    "name": "openmarch-sync-prototype",
    "main": "server/worker.js",
    "compatibility_date": "2026-05-01",
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"],
    },
    "durable_objects": {
        "bindings": [{ "name": "SHOWS", "class_name": "ShowSession" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShowSession"] }],
}
