---
import { Badge } from "@openmarch/ui";
import { Image } from "astro:assets";
import Shot from "@/components/directors/Shot.astro";
import { FREE_SEATS_PER_ENSEMBLE, SEAT_PRICE_LABEL } from "@/lib/seats";

import viewVertDark from "@/assets/otm/viewvertdark.png";
import viewVertLight from "@/assets/otm/viewvertlight.png";
import drillchart from "@/assets/desktop/drillchart.png";

const card =
    "bg-fg-1 border border-stroke rounded-6 p-24 flex flex-col gap-16 h-435 overflow-clip relative max-[850px]:h-auto max-[520px]:p-16";
const shot =
    "border border-stroke h-auto w-full rounded-6 object-cover object-top";
---

<section class="flex w-full min-w-0 flex-col gap-8" id="handout">
    <Badge>Friday</Badge>
    <h1
        class="text-text text-[3.5rem] leading-[115%] max-[768px]:text-h1 max-[520px]:text-h2"
    >
        Every kid leaves with their own dots
    </h1>
    <section
        class="grid grid-cols-2 grid-rows-2 gap-16 max-[850px]:grid-cols-1 max-[850px]:grid-rows-none"
    >
        <div class={card}>
            <h3 class="text-h3 leading-none max-[520px]:text-h4">
                On paper, one page each
            </h3>
            <p class="text-body leading-relaxed text-text-subtitle">
                Export PDF drill charts and coordinate sheets from the desktop
                app. Individual charts mark where each marcher was, is and goes
                next, and your notes for every page print in an appendix.
            </p>
            <Shot
                id="files-export-charts"
                alt="The Export dialog on the Drill Charts tab, with Individual Drill Charts and Include notes appendix pages turned on and a preview of one marcher's chart."
                class={shot}
            />
        </div>
        <div class={`${card} max-[850px]:min-h-380 max-[520px]:min-h-320`}>
            <h3 class="text-h3 leading-none max-[520px]:text-h4">
                On the phone already in their pocket
            </h3>
            <p class="text-body leading-relaxed text-text-subtitle">
                Publish to <a href="/mobile" class="text-accent underline"
                    >On The Move</a
                > and each performer sees their own dot, their coordinates and the
                whole show moving. No student accounts. {
                    FREE_SEATS_PER_ENSEMBLE
                } seats are free, then {SEAT_PRICE_LABEL} a seat for the season.
            </p>
            <span class="flex w-full items-center justify-center">
                <span class="z-3">
                    <Image
                        src={viewVertDark}
                        alt="On The Move on a phone, showing one performer's dot on the field"
                        width={384}
                        height={786}
                        format="webp"
                        quality={80}
                        class="hidden dark:block aspect-384/786 h-393 w-auto object-center object-contain max-[950px]:h-340 max-[520px]:h-280"
                    />
                    <Image
                        src={viewVertLight}
                        alt="On The Move on a phone, showing one performer's dot on the field"
                        width={384}
                        height={786}
                        format="webp"
                        quality={80}
                        class="block dark:hidden aspect-384/786 h-393 w-auto object-center object-contain max-[950px]:h-340 max-[520px]:h-280"
                    />
                </span>
                <Image
                    src={drillchart}
                    alt="A printed drill chart"
                    width={576}
                    height={444}
                    format="webp"
                    quality={80}
                    class="aspect-288/222 h-222 -ml-48 z-2 w-auto object-center object-contain max-[950px]:h-190 max-[520px]:h-150 max-[520px]:-ml-32"
                />
            </span>
        </div>
        <div class={card}>
            <h3 class="text-h3 leading-none max-[520px]:text-h4">
                On the band room projector
            </h3>
            <p class="text-body leading-relaxed text-text-subtitle">
                Export a video of the whole show from above, with the music.
                Students and staff watch the drill without opening OpenMarch.
            </p>
            <Shot
                id="files-video-overlay"
                alt="An exported video of the show from above, with the set, count, measure and time written along the bottom."
                class={shot}
            />
        </div>
        <div class={card}>
            <h3 class="text-h3 leading-none max-[520px]:text-h4">
                At the booster meeting
            </h3>
            <p class="text-body leading-relaxed text-text-subtitle">
                The 3D View puts the band in a stadium, in uniform, in front of
                a crowd. It’s the fastest way to show parents what the
                fundraiser is paying for.
            </p>
            <Shot
                id="3d-marchers"
                alt="The 3D View: a marching band in purple uniforms with a drumline and color guard on a football field, in front of full stands."
                class={`${shot} mt-auto`}
            />
        </div>
    </section>
</section>
