---
import { Badge, Button } from "@openmarch/ui";
import ThemedMedia from "./ThemedMedia.astro";
---

<section
    id="landing"
    class="relative flex h-fit flex-col min-w-0 w-full items-center justify-center gap-16 border border-stroke pt-32 pb-8 px-8 rounded-[14px]"
>
    <a href="/#stadium"
        ><Badge variant="secondary"
            ><span class="text-accent">New in 0.2:</span> 3D View</Badge
        ></a
    >
    <h1
        class="text-h1 leading-[130%] max-[580px]:text-h2 max-[580px]:w-full w-[512px] tracking-tighter text-center motion-preset-slide-up motion-delay-150"
    >
        Write the drill.<br />Watch the show.
    </h1>
    <p class="text-body text-center max-w-[512px] motion-delay-250">
        OpenMarch is free, open-source drill writing software for the marching
        arts. Chart every count, then see it performed in a stadium.
    </p>
    <div class="flex flex-wrap justify-center gap-8 motion-delay-250">
        <a href="/download">
            <Button>Download</Button>
        </a>
        <a href="https://editor.openmarch.com">
            <Button variant="secondary">Open the web editor</Button>
        </a>
    </div>
    <p class="text-sub text-text-subtitle text-center">
        Mac, Windows and Linux · Web · Tablet
    </p>

    <div class="flex flex-col items-center">
        <ThemedMedia
            name="3d-view/3d-marchers"
            alt="A marching band in uniform on a stadium field in the 3D View"
            width={1360}
            height={500}
            eager
            class="border border-stroke rounded-6 aspect-1360/500 h-auto w-[86%] z-20 motion-preset-slide-up-sm motion-delay-300"
        />
        <ThemedMedia
            name="workspace/window-overview"
            alt="The same show as a drill chart in the OpenMarch editor"
            width={1600}
            height={1000}
            eager
            class="border border-stroke rounded-6 aspect-1600/1000 h-auto w-full mt-[-110px] max-[950px]:mt-[-60px] max-[560px]:mt-[-24px] z-30 motion-preset-slide-up-sm motion-delay-[400ms]"
        />
    </div>
    <div
        class="absolute top-0 motion-preset-fade-lg motion-delay-300 left-1/2 -translate-x-1/2 -z-50 size-[900px] max-[640px]:size-[300px]"
        style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 65%); opacity: 0.4;"
    >
    </div>
</section>
