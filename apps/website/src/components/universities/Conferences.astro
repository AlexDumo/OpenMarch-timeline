---
import { Image } from "astro:assets";
import { ArrowRightIcon } from "@phosphor-icons/react";
import vmea from "@/content/blog/2025-12-02-vmea-conference/IMG_2555-2.jpg";
import midwest from "@/content/blog/2026-01-15-Midwest/DSC06374-2.jpg";

const visits = [
    {
        name: "VMEA Conference",
        when: "November 2025",
        text: "Three days with Virginia's music educators, and conversations with more than 150 teachers, students and performers.",
        href: "/blog/2025-12-02-vmea-conference",
        image: vmea,
        alt: "The OpenMarch team at their booth at the VMEA conference",
    },
    {
        name: "The Midwest Clinic",
        when: "December 2025",
        text: "Live demos for directors, educators and students from across the marching arts, in Chicago.",
        href: "/blog/2026-01-15-midwest",
        image: midwest,
        alt: "The OpenMarch team at their booth at the Midwest Clinic",
    },
];
---

<section id="conferences" class="flex w-full min-w-0 flex-col gap-8">
    <h1 class="text-h1 max-[580px]:text-h2">Meet us where teachers meet</h1>
    <p class="text-body leading-relaxed text-text-subtitle max-w-[40rem]">
        The OpenMarch team shows the software in person at music education
        conferences. Bring your questions, or your students.
    </p>
    <div class="grid grid-cols-2 gap-16 mt-8 max-[850px]:grid-cols-1">
        {
            visits.map((v) => (
                <a
                    href={v.href}
                    class="group bg-fg-1 border border-stroke rounded-6 overflow-clip flex flex-col duration-150 hover:border-accent"
                >
                    <Image
                        src={v.image}
                        alt={v.alt}
                        width={1200}
                        height={675}
                        format="webp"
                        quality={80}
                        loading="lazy"
                        class="aspect-video w-full object-cover"
                    />
                    <div class="flex flex-col gap-8 p-24 max-[520px]:p-16">
                        <p class="font-mono text-sub text-accent">{v.when}</p>
                        <h3 class="text-h3 leading-none max-[520px]:text-h4">
                            {v.name}
                        </h3>
                        <p class="text-body leading-relaxed text-text-subtitle">
                            {v.text}
                        </p>
                        <p class="flex items-center gap-6 text-body text-text">
                            Read the story <ArrowRightIcon size={16} />
                        </p>
                    </div>
                </a>
            ))
        }
    </div>
</section>
