---
/**
 * "It goes with them": one show file followed from the techniques class to a
 * first teaching job, drawn as a follow-the-leader pathway.
 */
import { Badge, getButtonClassName } from "@openmarch/ui";
import { Image } from "astro:assets";
import DocsMedia from "./DocsMedia.astro";
import { EDITOR_URL } from "@/data/universities";
import viewVertDark from "@/assets/otm/viewvertdark.png";
import viewVertLight from "@/assets/otm/viewvertlight.png";

const stops = [
    { x: 125, y: 35, label: "Techniques class" },
    { x: 375, y: 75, label: "Their own laptop" },
    { x: 625, y: 35, label: "Student teaching" },
    { x: 875, y: 75, label: "First job" },
];
const path =
    "M 0 75 C 60 75, 65 35, 125 35 S 315 75, 375 75 S 565 35, 625 35 S 815 75, 875 75 S 960 40, 1000 40";
const train = Array.from({ length: 7 }, (_, i) => i);
const card =
    "bg-fg-1 border border-stroke rounded-6 p-24 flex flex-col gap-16 h-435 overflow-clip max-[850px]:h-auto max-[520px]:p-16";
const step = "font-mono text-sub text-accent flex items-center gap-8";
const stepDot =
    "flex h-20 w-20 shrink-0 items-center justify-center rounded-full border border-accent text-micro";
---

<section id="after-class" class="flex w-full min-w-0 flex-col gap-8">
    <Badge>After the final</Badge>
    <h1
        class="text-text text-[3.5rem] leading-[115%] max-[768px]:text-h1 max-[520px]:text-h2"
    >
        It goes with them
    </h1>
    <p class="text-body leading-relaxed text-text-subtitle max-w-[40rem]">
        The tool they learn in your class is the one they open in their first
        band room. Nothing expires at graduation.
    </p>

    <!-- Follow-the-leader pathway -->
    <div class="mt-8 flex flex-col gap-4 max-[700px]:hidden" aria-hidden="true">
        <svg viewBox="0 0 1000 110" class="uni-pathway block h-auto w-full">
            <path
                id="uni-pathway-line"
                d={path}
                fill="none"
                stroke="var(--color-accent)"
                stroke-opacity="0.5"
                stroke-width="1.5"
                stroke-dasharray="5 6"></path>
            {
                train.map((i) => (
                    <circle
                        r={i === 0 ? 6 : 5}
                        fill="var(--color-accent)"
                        fill-opacity={1 - i * 0.1}
                    >
                        <animateMotion
                            dur="16s"
                            begin={`${-8 - i * -0.32}s`}
                            repeatCount="indefinite"
                        >
                            <mpath href="#uni-pathway-line" />
                        </animateMotion>
                    </circle>
                ))
            }
            {
                stops.map((s, i) => (
                    <g transform={`translate(${s.x} ${s.y})`}>
                        <circle
                            r="12"
                            fill="var(--color-bg-1)"
                            stroke="var(--color-accent)"
                            stroke-width="1.5"
                        />
                        <text
                            y="4.5"
                            text-anchor="middle"
                            font-size="13"
                            class="font-mono"
                            fill="var(--color-accent)"
                        >
                            {i + 1}
                        </text>
                    </g>
                ))
            }
        </svg>
        <div
            class="grid grid-cols-4 text-center font-mono text-sub text-text-subtitle"
        >
            {stops.map((s) => <span>{s.label}</span>)}
        </div>
    </div>

    <section class="grid grid-cols-2 gap-16 mt-8 max-[850px]:grid-cols-1">
        <div class={card}>
            <p class={step}><span class={stepDot}>1</span>Techniques class</p>
            <h3 class="text-h3 leading-none max-[520px]:text-h4">
                A browser tab in the lab
            </h3>
            <p class="text-body leading-relaxed text-text-subtitle">
                The editor runs at editor.openmarch.com. There is nothing to
                install on lab machines and nothing to ask IT to license.
            </p>
            <div class="rounded-6 border border-stroke bg-fg-2 overflow-clip">
                <div
                    class="flex items-center gap-8 border-b border-stroke px-12 py-6"
                >
                    <span class="flex gap-4">
                        <span class="size-8 rounded-full bg-stroke"></span>
                        <span class="size-8 rounded-full bg-stroke"></span>
                        <span class="size-8 rounded-full bg-stroke"></span>
                    </span>
                    <span
                        class="flex-1 rounded-full border border-stroke bg-bg-1 px-12 py-2 font-mono text-sub text-text-subtitle"
                    >
                        editor.openmarch.com
                    </span>
                </div>
                <DocsMedia
                    base="workspace/window-overview"
                    alt="The OpenMarch editor open in a browser"
                    width={1600}
                    height={1000}
                    class="h-auto w-full"
                />
            </div>
        </div>

        <div class={card}>
            <p class={step}><span class={stepDot}>2</span>Their own laptop</p>
            <h3 class="text-h3 leading-none max-[520px]:text-h4">
                Homework on whatever they own
            </h3>
            <p class="text-body leading-relaxed text-text-subtitle">
                The same editor in any browser, or the desktop app on Mac,
                Windows and Linux. A show is one file they can take anywhere.
            </p>
            <DocsMedia
                base="shapes/shapes-pathways"
                alt="A block of performers following pathways to the next form"
                width={1424}
                height={892}
                class="border border-stroke h-auto w-full rounded-6 object-cover object-center"
            />
        </div>

        <div class={card}>
            <p class={step}><span class={stepDot}>3</span>Student teaching</p>
            <h3 class="text-h3 leading-none max-[520px]:text-h4">
                On a tablet, with a pencil
            </h3>
            <p class="text-body leading-relaxed text-text-subtitle">
                OpenMarch has a tablet layout and works with Apple Pencil, so
                the drill comes to rehearsal with them.
            </p>
            <div class="rounded-16 border border-stroke bg-fg-2 p-8">
                <DocsMedia
                    base="workspace/workspace-tablet-layout"
                    alt="OpenMarch in its tablet layout"
                    width={1600}
                    height={1000}
                    class="h-auto w-full rounded-8 border border-stroke"
                />
            </div>
        </div>

        <div class:list={[card, "relative"]}>
            <p class={step}><span class={stepDot}>4</span>First job</p>
            <h3 class="text-h3 leading-none max-[520px]:text-h4">
                Still theirs, still free
            </h3>
            <p class="text-body leading-relaxed text-text-subtitle">
                Graduates keep OpenMarch and write for their own band. They can
                show the staff a 3D video, and their performers can follow the
                drill in On The Move.
            </p>
            <div class="relative">
                <DocsMedia
                    base="3d-view/3d-marchers"
                    alt="A marching band in uniform in 3D View"
                    width={1360}
                    height={500}
                    class="border border-stroke aspect-1328/800 h-auto w-full rounded-6 object-cover object-center"
                />
                <Image
                    src={viewVertDark}
                    alt="A performer's drill in the On The Move app"
                    width={384}
                    height={786}
                    format="webp"
                    quality={80}
                    class="hidden dark:block absolute right-24 top-24 h-280 w-auto max-[520px]:h-190 max-[520px]:right-12"
                />
                <Image
                    src={viewVertLight}
                    alt="A performer's drill in the On The Move app"
                    width={384}
                    height={786}
                    format="webp"
                    quality={80}
                    class="block dark:hidden absolute right-24 top-24 h-280 w-auto max-[520px]:h-190 max-[520px]:right-12"
                />
            </div>
        </div>
    </section>
    <div
        class="p-32 flex justify-between items-center gap-16 border border-accent rounded-full max-[640px]:rounded-6 max-[640px]:p-16 max-[640px]:flex-col max-[640px]:items-stretch"
    >
        <h1 class="text-h1 max-[640px]:text-h2">Try it before class</h1>
        <a
            href={EDITOR_URL}
            class={getButtonClassName({
                variant: "primary",
                className: "max-[640px]:w-full",
            })}
        >
            Open the editor
        </a>
    </div>
</section>

<script>
    // The pathway holds still for readers who ask for reduced motion.
    const svg = document.querySelector<SVGSVGElement>(".uni-pathway");
    if (svg && matchMedia("(prefers-reduced-motion: reduce)").matches) {
        svg.pauseAnimations();
    }
</script>
